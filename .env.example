# ==========================================================================
# Seedha Properties — environment template  (COMPLETE)
#
# Copy to `.env` for local dev. `.env` is gitignored: real secrets live in the
# hosting provider (Vercel/Cloudflare → Environment Variables), the Supabase
# dashboard, and GitHub Actions secrets — never in git.
#
#   VITE_*  → inlined into the CLIENT bundle at build time. PUBLIC by
#             definition. Never put a secret behind a VITE_ prefix — the build
#             (src/config/env.ts) fails on purpose if you do.
#   others  → read at RUNTIME on the SERVER only.
#   🔑      → SECRET. Rotate at the provider, then update everywhere it is set
#             (see the destination note on each). Never paste real values here.
#
# WHERE A ROTATED VALUE MUST GO (per secret, see notes below):
#   • local  = this .env (dev only)
#   • host   = Vercel/Cloudflare Environment Variables (production runtime)
#   • ci     = GitHub → Settings → Secrets and variables → Actions
#   • sb     = Supabase Dashboard (DB password / SMTP)
# A full step-by-step rotation checklist is in KEYS_TO_ADD.md.
# ==========================================================================


# ── 1. Supabase — CLIENT (browser) ────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase publishable / anon key>   # public by design (RLS-protected)
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ── 2. Supabase — SERVER (SSR + API routes) ───────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase publishable / anon key>
SUPABASE_PROJECT_ID=<project-ref>

# 🔑 SECRET — bypasses RLS. Supabase → Project Settings → API → service_role.
#    Destinations: local + host. Without it the /admin portal and enquiry
#    submissions return 503.
SUPABASE_SERVICE_ROLE_KEY=<supabase service_role key>

# 🔑 SECRET — Supabase Management API + CLI (used by tooling/scripts, not the app).
#    Supabase → Account → Access Tokens. Destination: local (+ ci if scripts run there).
SUPABASE_ACCESS_TOKEN=<supabase personal access token>

# 🔑 SECRET — direct Postgres connection string for CD migrations (`supabase db push`).
#    Supabase → Project Settings → Database → Connection string (Session/URI).
#    Destination: ci (GitHub Actions secret). Rotating the DB password changes this.
# SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/postgres

# 🔑 SECRET — direct Postgres URLs for local DB tooling/migrations (if used).
#    Same source as above. Destination: local.
# DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://<user>:<password>@<host>:5432/postgres


# ── 3. App origin & feature flags ─────────────────────────────────────────
# The origin this deployment is served from — drives canonical URLs, OG tags,
# JSON-LD, sitemap.xml. If unset, falls back to https://seedhaproperties.com,
# so a preview would otherwise advertise production URLs to search engines.
VITE_APP_URL=https://seedhaproperties.com

# OPTIONAL — runtime feature-flag overrides, comma-separated.
#   e.g. VITE_FEATURES="owner.upload,customer.mapView"
# VITE_FEATURES=


# ── 4. Google Maps & Geocoding (client) ───────────────────────────────────
# Public by design (browser SDK). RESTRICT BY HTTP REFERRER at Google Cloud.
# Google Cloud Console → APIs & Services → Credentials. Destinations: local + host.
VITE_GOOGLE_MAPS_API_KEY=<google maps browser api key>


# ── 5. Seedha AI Assistant (Google Gemini) ────────────────────────────────
# 🔑 SECRET — server-only; the call is proxied through /api/ai/chat. Must NOT
#    get a VITE_ prefix (that would publish it to every visitor). Google AI
#    Studio → Get API key. Destinations: local + host. Unset ⇒ AI falls back
#    to a local response engine.
GEMINI_API_KEY=<gemini api key>


# ── 6. Transactional email (Resend) ───────────────────────────────────────
# 🔑 SECRET — server-only. Powers sign-in alerts, enquiry confirmations,
#    approvals, and the login OTP. Resend → API Keys. Also needs a VERIFIED
#    sending domain. Destinations: local + host. Unset ⇒ email reports
#    `unconfigured` (never silently "sent").
RESEND_API_KEY=<resend api key>


# ── 7. Payments — Razorpay (owner assistance plans) ───────────────────────
# RAZORPAY_KEY_ID is public-ish (sent to the browser for checkout).
# 🔑 RAZORPAY_KEY_SECRET is SECRET — server-only; it signs/verifies payments.
#    Razorpay → Settings → API Keys (use rzp_test_… until live).
#    Destinations: local + host. Unset ⇒ plans render read-only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=<razorpay key secret>


# ── 8. Payments — Stripe (contact-pass plans) ─────────────────────────────
# 🔑 SECRET — server-only. Stripe → Developers → API keys. The webhook secret
#    comes from the endpoint you register (Developers → Webhooks). Code refuses
#    any sk_live_ key (test-only guard). Destinations: local + host.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx


# ── 9. Anti-spam — Cloudflare Turnstile (enquiry/contact forms) ───────────
# Site key is public; 🔑 TURNSTILE_SECRET_KEY is server-only. Set together.
# Cloudflare → Turnstile. Destinations: site key local+host, secret local+host.
# Unset ⇒ CAPTCHA verification is skipped gracefully.
# VITE_TURNSTILE_SITE_KEY=<turnstile site key>
# TURNSTILE_SECRET_KEY=<turnstile secret key>
# TURNSTILE_SECRET=<alias accepted if _KEY not set>
# TURNSTILE_HOSTNAMES=seedhaproperties.com,www.seedhaproperties.com   # optional allowlist


# ── 10. Lead notifications — WhatsApp / SMS (all optional) ────────────────
# 🔑 WHATSAPP_ACCESS_TOKEN is SECRET (Meta Cloud API). Only fire when set.
#    Meta for Developers → WhatsApp → API Setup. Destinations: host (+ local to test).
# WHATSAPP_PHONE_NUMBER_ID=<meta whatsapp phone number id>
# WHATSAPP_ACCESS_TOKEN=<meta whatsapp access token>
# WHATSAPP_WEBHOOK_URL=<optional custom whatsapp webhook>
# SMS_GATEWAY_URL=<optional sms gateway endpoint>


# ── 11. Monitoring & alerting ─────────────────────────────────────────────
# Sentry DSN is public-by-design (browser ingest). Sentry → Project → Client Keys.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Server alert webhook (Slack/Discord/PagerDuty). Payload is metrics-only + PII-scrubbed.
# ALERT_WEBHOOK_URL=<incoming webhook url>
# 🔑 UptimeRobot API key for ops/monitoring scripts. Destination: local (+ ci).
# UPTIMEROBOT_API_KEY=<uptimerobot api key>


# ── 12. QA role accounts — TEST ONLY (auth lifecycle suites) ──────────────
# Throwaway verification accounts, NOT production users. Destinations: local + ci.
# Unset ⇒ the auth lifecycle suites skip with an explicit message.
# QA_CUSTOMER_EMAIL=customer.qa@example.in
# QA_CUSTOMER_PASSWORD=<qa customer password>
# QA_OWNER_EMAIL=owner.qa@example.in
# QA_OWNER_PASSWORD=<qa owner password>
# QA_AGENT_EMAIL=agent.qa@example.in
# QA_AGENT_PASSWORD=<qa agent password>
# QA_ADMIN_EMAIL=admin.qa@example.in
# QA_ADMIN_PASSWORD=<qa admin password>

# ── 13. Location Autocomplete — Geoapify (client) ─────────────────────────
# Client-visible by design: the autocomplete request is made from the browser,
# so this key ships in the bundle and CANNOT be kept secret. Restrict it by
# allowed domain in the Geoapify dashboard and set a usage cap.
# VITE_GEOAPIFY_API_URL only needs setting to override the default endpoint.
# VITE_GEOAPIFY_API_KEY=<geoapify api key>
# VITE_GEOAPIFY_API_URL=https://api.geoapify.com/v1/geocode/autocomplete


# ── 14. CI/CD — GitHub Actions secrets (NOT in this .env) ─────────────────
# These live only in GitHub → Settings → Secrets and variables → Actions:
#   🔑 VERCEL_TOKEN            deploy auth        (Vercel → Account → Tokens)
#      VERCEL_ORG_ID           deploy target      (Vercel project settings)
#      VERCEL_PROJECT_ID       deploy target
#   🔑 SUPABASE_DB_URL         migrations         (see §2)
#      PRODUCTION_URL          post-deploy smoke check
#      E2E_BASE_URL            e2e target
#   + build-time: VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_APP_URL


# ==========================================================================
# FLUTTER (apps/mobile) — passed via --dart-define at build time, NOT read
# from this file. Listed here so the full surface is documented in one place.
#
#   flutter build apk \
#     --dart-define=SUPABASE_URL=... \
#     --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=API_BASE_URL=... \
#     --dart-define=GEOAPIFY_API_KEY=...
#
# All four are client-visible: they are compiled into the shipped binary.
# Never pass a service-role key or any other secret this way.
# ==========================================================================
