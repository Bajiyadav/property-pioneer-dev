# ==========================================================================
# Urban Properties — environment template
#
# Copy to `.env` for local development. `.env` is gitignored: real secrets
# belong in Vercel (Project → Settings → Environment Variables), never in git.
#
#   VITE_*  are inlined into the CLIENT bundle at build time. Public by
#           definition — never put a secret behind a VITE_ prefix.
#   others  are read at runtime on the server only.
# ==========================================================================

# ── REQUIRED — client (browser) ───────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase publishable / anon key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ── REQUIRED — server (SSR + API routes) ──────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase publishable / anon key>
SUPABASE_PROJECT_ID=<project-ref>

# SECRET. Bypasses RLS — server-only, never expose to the client.
# Supabase Dashboard → Project Settings → API → service_role.
# Without it: /admin portal and enquiry submissions return 503.
SUPABASE_SERVICE_ROLE_KEY=<supabase service_role key>

# ── REQUIRED for correct SEO ──────────────────────────────────────────────
# The origin this deployment is actually served from. Drives canonical URLs,
# Open Graph tags, JSON-LD and sitemap.xml. If unset it falls back to
# https://seedhaproperties.com — the production origin, so a preview
# deployment would otherwise advertise production URLs to search engines.
VITE_APP_URL=https://property-pioneer-dev.vercel.app

# ── OPTIONAL — Cloudflare Turnstile (anti-spam on enquiry forms) ──────────
# Both must be set together. When TURNSTILE_SECRET_KEY is absent, CAPTCHA
# verification is skipped and forms still work.
# VITE_TURNSTILE_SITE_KEY=<turnstile site key>
# TURNSTILE_SECRET_KEY=<turnstile secret key>

# ── OPTIONAL — transactional email provider (Resend) ──────────────────────
# SECRET. Server-only — never give this a VITE_ prefix.
# Powers the "new sign-in" security alert and other transactional email.
# When unset, authentication works normally and delivery is reported as
# `unconfigured`; nothing is ever reported as sent that was not sent.
# Also requires a verified sending domain for notifications@seedhaproperties.com.
# RESEND_API_KEY=<resend api key>

# ── TEST-ONLY — QA role accounts for the auth lifecycle suites ────────────
# Throwaway verification accounts, NOT production users. Never commit real
# values: keep them in this gitignored .env locally and in CI secrets.
# When unset, the auth lifecycle suites skip with an explicit message instead
# of silently passing.
# QA_CUSTOMER_EMAIL=customer.qa@urbanproperties.in
# QA_CUSTOMER_PASSWORD=<qa customer password>
# QA_OWNER_EMAIL=owner.qa@urbanproperties.in
# QA_OWNER_PASSWORD=<qa owner password>
# QA_AGENT_EMAIL=agent.qa@urbanproperties.in
# QA_AGENT_PASSWORD=<qa agent password>
# QA_ADMIN_EMAIL=admin.qa@urbanproperties.in
# QA_ADMIN_PASSWORD=<qa admin password>
