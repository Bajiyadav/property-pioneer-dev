# Generated by the Flutter toolchain — never source.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Platform scaffolding is generated on demand by mobile-build.yml
# (`flutter create . --platforms=android`), so it is not tracked here.
/android/
/ios/
/web/
/macos/
/linux/
/windows/

# pubspec.lock IS tracked: this is an application, not a library, and a pinned
# resolution is what makes a CI build reproducible.
